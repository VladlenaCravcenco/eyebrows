# Эти переменные задаются в Vercel → Project → Settings → Environment Variables.
# Локально файл .env не нужен.

# Токен бота от @BotFather (никому не показывайте)
BOT_TOKEN=

# Telegram ID руководителей через запятую. Узнать свой ID: написать боту /myid
MANAGER_IDS=

# Любая длинная случайная строка — защищает ежедневные напоминания от посторонних
CRON_SECRET=

# Задаются автоматически, когда подключаете Upstash Redis в Vercel → Storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
